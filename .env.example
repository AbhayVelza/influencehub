# Copy to .env.local (gitignored) and fill in. Vite reads .env, then .env.local, then the shell.
# Only VITE_* variables reach the browser bundle, and every one of them is public: never put a secret in a VITE_ var.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app). Public values, required;
# without them the app shows a "Firebase isn't configured" screen. See docs/auth.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Needed for document uploads, e.g. my-project.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=
# Optional.
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------------------------------------------------
# Secrets: put these in .env.local (gitignored) or the shell, NEVER in .env (it is committed).
#
# The first admin, created by `npm run seed:admin` in Firebase. The password needs at least 8 characters.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin
#
# Used only by `npm run seed:admin`: path to a Firebase service account key JSON (Firebase console > Project settings >
# Service accounts > Generate new private key). Keep the file outside the repo, or name it service-account*.json
# (gitignored). FIREBASE_PROJECT_ID is optional when the key file names the project.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
# FIREBASE_PROJECT_ID=
