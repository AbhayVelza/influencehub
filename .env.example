# Copy to .env.local (gitignored) and fill in. Never put secrets in the committed .env.

# "true" = the app uses the API server over PostgreSQL (npm run server); leave empty for prototype mode.
VITE_API_SERVER=true
# Only when the API server is on another origin than the app.
VITE_API_URL=

# The API server (secret). See docs/server.md.
DATABASE_URL=postgres://influencehub:<password>@localhost:5432/influencehub
# PORT=3001
# CORS_ORIGIN=

# The first admin, set on server start while they have no password (at least 8 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
