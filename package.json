{
  "name": "influencehub-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "server:build": "vite build --config vite.server.config.ts",
    "server": "npm run server:build && npm run start",
    "start": "node --env-file-if-exists=.env.local dist-server/main.js",
    "server:supabase": "npm run server:build && npm run start -- --supabase",
    "db:copy": "node --env-file-if-exists=.env.local scripts/db-copy.mjs",
    "db:migrate": "npm run server:build && node --env-file-if-exists=.env.local dist-server/migrate.js",
    "test": "node scripts/vitest.mjs run",
    "test:perf": "node scripts/vitest.mjs run --config vitest.perf.config.ts",
    "db:backup": "node --env-file-if-exists=.env.local scripts/db-backup.mjs",
    "set-password": "node --env-file-if-exists=.env.local scripts/set-password.mjs",
    "test:e2e": "playwright test",
    "test:e2e:server": "npm run server:build && playwright test --config playwright.server.config.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.18",
    "lucide-react": "^1.63.0",
    "msw": "^3.0.3",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  }
}
