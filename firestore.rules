rules_version = '2';

// InfluenceHub has no API server: the browser reads and writes Firestore directly (src/backend). These rules are
// the access control. Deploy with: firebase deploy --only firestore:rules
//
// Who gets in: a signed-in Firebase user whose team/{uid} record exists and is active. Anyone else (including
// people who sign up on their own) can read only their own team record, which is how the app tells them they
// have no access.
//
// Finer rules (an executive sees only their own influencers, stage rules, claim limits) are applied by the app's
// data layer, not here; see docs/auth.md "What the rules do and don't enforce".
service cloud.firestore {
  match /databases/{database}/documents {
    function me() {
      return get(/databases/$(database)/documents/team/$(request.auth.uid)).data;
    }
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/team/$(request.auth.uid))
        && me().is_active == true;
    }
    function hasRole(roles) {
      return isMember() && me().role in roles;
    }

    // Team records are keyed by Firebase uid. Admins add and change members (never delete: deactivate instead).
    match /team/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isMember();
      allow create, update: if hasRole(['admin']);
      allow delete: if false;
    }

    // Configuration: everyone reads, admins change.
    match /categories/{id} {
      allow read: if isMember();
      allow write: if hasRole(['admin']);
    }
    match /settings/{id} {
      allow read: if isMember();
      allow write: if hasRole(['admin']);
    }

    // Influencers: any member adds and updates (claims, stage moves, calls, auto-release); only managers and admins delete.
    match /influencers/{id} {
      allow read, create, update: if isMember();
      allow delete: if hasRole(['admin', 'manager']);
    }

    // Working data every member reads and writes through the app.
    match /{collection}/{id} {
      allow read, write: if isMember()
        && collection in ['calls', 'packages', 'activities', 'documents', 'saved_views', 'dismissed_duplicates'];
    }
  }
}
